rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/models/{modelId}/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.size < 200 * 1024 * 1024;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/thumbnails/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }

    // Asset Library cache: disposable copies of authoritative GitHub bytes. Written only by the Admin SDK and
    // delivered only through the API's short-lived signed URLs, which do not consult these rules.
    match /asset-library-cache/{allPaths=**} {
      allow read, write: if false;
    }
  }
}

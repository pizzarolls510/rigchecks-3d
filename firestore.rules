rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Asset Library job metadata (derived state only, never manifest data). Any Asset Library role may read job
    // status; only the Admin SDK in the API writes. The mutation lock and per-user rate counters are server-only.
    match /assetLibraryJobs/{jobId} {
      allow read: if request.auth != null && request.auth.token.get('assetLibraryRole', null) in ['reader', 'writer'];
      allow write: if false;
    }
    match /assetLibraryLocks/{lockId} {
      allow read, write: if false;
    }
    match /assetLibraryRate/{userId} {
      allow read, write: if false;
    }
  }
}
